rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only users registered in the `admins` collection may write catalogue data.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function nonNegative(value) {
      return value is number && value >= 0;
    }

    function validProduct() {
      let d = request.resource.data;
      return d.name is string
        && d.name.size() >= 3
        && d.name.size() <= 200
        && d.slug is string
        && d.shortDescription is string
        && d.shortDescription.size() <= 1000
        && d.description is string
        && d.description.size() <= 20000
        && d.status in ['draft', 'active', 'inactive']
        && d.availability in ['in-stock', 'limited', 'out-of-stock']
        && d.categorySpecs is map
        && d.customSpecs is list
        && d.imageUrl is string
        && d.additionalImages is list
        && d.documents is list
        && nonNegative(d.availableQuantity);
    }

    // ------------------------------------------------------------------
    // Admin registry (bootstrapped from the Firebase console)
    // ------------------------------------------------------------------
    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Products — customers can only read active products. Customer-facing
    // list queries must filter on status == 'active'. Records saved before
    // `status` existed stay readable by id until they have been migrated.
    // ------------------------------------------------------------------
    match /products/{productId} {
      allow get: if resource == null
        || !('status' in resource.data)
        || resource.data.status == 'active'
        || isAdmin();

      allow list: if resource.data.status == 'active' || isAdmin();

      allow create, update: if isAdmin() && validProduct();

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Catalogue settings — admin only
    // ------------------------------------------------------------------
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Enquiries — anyone can submit a new enquiry, only admins can read
    // and update the status of existing ones.
    // ------------------------------------------------------------------
    match /enquiries/{enquiryId} {
      allow read: if isAdmin();

      // A tap on a WhatsApp button: no name or phone, just what was asked about.
      allow create: if
        request.resource.data.keys().hasOnly([
          'source', 'page', 'name', 'phone', 'productId', 'productName', 'quantity', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.source == 'whatsapp'
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name == ''
        && request.resource.data.phone == ''
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 100
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 200
        && request.resource.data.quantity is string
        && request.resource.data.quantity.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000;

      // The website contact form.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'productId', 'productName', 'quantity', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 25
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000;

      allow update: if isAdmin()
        && request.resource.data.status in ['new', 'contacted', 'completed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if isAdmin();
    }

    // Everything else stays private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
