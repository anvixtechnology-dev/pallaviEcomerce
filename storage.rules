rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Only users registered in the Firestore `admins` collection may upload.
    function isAdmin() {
      return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function validImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    // Writes are scoped to the image folders the app uses.
    // Product images: admin managed, images only, max 5 MB.
    match /products/{productId}/{fileName} {
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // Category images: admin managed, images only, max 5 MB.
    match /categories/{categoryId}/{fileName} {
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // Every object in this bucket is a public catalogue image, so reads
    // (get and list) are public. The multi-segment wildcard matches both
    // individual file paths and folder list/listAll requests.
    match /{allPaths=**} {
      allow read: if true;
    }

    // Anything outside the image folders is not writable.
    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
